#!/usr/bin/env bash
set -euo pipefail

DEST="$1"
if [[ -z "$DEST" ]]; then
    echo "Usage: $0 <path-to-clone-ansible-repo-into>"
    exit 1
fi

OS_NAME="$(uname -s)"

if [[ "$OS_NAME" == "Darwin" ]]; then

    # --- macOS INSTALLATION PATH -----------------------------------------

    if ! command -v git &>/dev/null; then
        echo "Installing Xcode Command Line Tools (for git)..."
        xcode-select --install

        while ! command -v git &>/dev/null; do
            sleep 2
        done
    fi

    if ! command -v brew &>/dev/null; then
        echo "Installing Homebrew..."
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi

    echo "Updating Homebrew..."
    brew update
    echo "Installing git & ansible via brew..."
    brew install git ansible

elif [[ -f "/etc/debian_version" ]]; then

    # --- Debian/Ubuntu LINUX PATH ----------------------------------------

    echo "Updating apt & installing curl & git & software-properties-common..."
    sudo apt update
    sudo apt install -y curl git software-properties-common

    echo "Adding Ansible PPA & installing ansible..."
    sudo add-apt-repository --yes --update ppa:ansible/ansible
    sudo apt update
    sudo apt install -y ansible

else
    echo "Unsupported OS: $OS_NAME"
    exit 1
fi

# --- CLONE THE REPO -----------------------------------------------------

mkdir -p "$(dirname "$DEST")"
echo "Cloning ansible into $DEST..."
git clone https://github.com/VincentVanCode101/ansible "$DEST"

echo "Setup complete! Now 'cd $DEST' and run your playbooks as documented."

default partial alphanumeric_keys
xkb_symbols "de-chris" {

    include "de(basic)" // Include the basic German layout

     // AltGr+7→|, Shift+AltGr+7→\
     key <AE07> { [ 7,    slash,      bar,         backslash ] };
    // AltGr+5→[, Shift+AltGr+5→{
     key <AE05> { [ 5,    percent,    bracketleft, braceleft ] };
    // AltGr+6→], Shift+AltGr+6→}
    key <AE06> { [ 6,    ampersand,  bracketright,braceright ] };
    // AltGr+8→{ (we duplicate into 4th level so Shift-AltGr+8 also {.)
     key <AE08> { [ 8,    parenleft,  braceleft,   braceleft ] };
    // AltGr+9→}
     key <AE09> { [ 9,    parenright, braceright,  braceright ] };

     // override letter keys:
    // AltGr+L→@
     key <AC09> { [ l, L, at, at ] };
    // AltGr+N→~, Shift+AltGr+N also ~
     key <AB06> { [ n, N, asciitilde, asciitilde ] };
};
